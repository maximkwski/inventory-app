<%- include('../partials/header', { title: title }) %>
<%- include('../partials/nav') %>

<main class="main-content">
<div class="container">
  <div class="content-wrapper fade-in">
    <h1><%= title %></h1>

    <form action="<%= item ? `/items/${item.id}/update` : '/items' %>" method="POST">
      <div class="form-group">
        <label for="name">Item Name *</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          value="<%= item ? item.name : '' %>" 
          placeholder="e.g., Heineken Lager"
          required
        >
      </div>

      <div class="form-group">
        <label for="brand">Brand *</label>
        <input 
          type="text" 
          id="brand" 
          name="brand" 
          value="<%= item ? item.brand : '' %>" 
          placeholder="e.g., Heineken"
          required
        >
      </div>

      <div class="form-group">
        <label for="category_id">Category *</label>
        <select id="category_id" name="category_id" required>
          <option value="">Select a category</option>
          <% categories.forEach(category => { %>
            <option 
              value="<%= category.id %>" 
              <%= item && item.category_id == category.id ? 'selected' : '' %>
            >
              <%= category.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea 
          id="description" 
          name="description"
          placeholder="Brief description of the product..."
        ><%= item ? item.description : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="price">Price ($) *</label>
          <input 
            type="number" 
            id="price" 
            name="price" 
            step="0.01" 
            min="0"
            value="<%= item ? item.price : '' %>" 
            placeholder="0.00"
            required
          >
        </div>

        <div class="form-group">
          <label for="stock_quantity">Stock Quantity *</label>
          <input 
            type="number" 
            id="stock_quantity" 
            name="stock_quantity" 
            min="0"
            value="<%= item ? item.stock_quantity : 0 %>" 
            placeholder="0"
            required
          >
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="alcohol_percentage">Alcohol % (ABV)</label>
          <input 
            type="number" 
            id="alcohol_percentage" 
            name="alcohol_percentage" 
            step="0.1" 
            min="0" 
            max="100"
            value="<%= item ? item.alcohol_percentage : '' %>"
            placeholder="e.g., 5.0"
          >
        </div>

        <div class="form-group">
          <label for="volume_ml">Volume (ml)</label>
          <input 
            type="number" 
            id="volume_ml" 
            name="volume_ml" 
            min="0"
            value="<%= item ? item.volume_ml : '' %>"
            placeholder="e.g., 750"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="country_of_origin">Country of Origin</label>
        <input 
          type="text" 
          id="country_of_origin" 
          name="country_of_origin" 
          value="<%= item ? item.country_of_origin : '' %>"
          placeholder="e.g., France"
        >
      </div>

      <div class="btn-group">
        <button type="submit" class="btn btn-success">
          <%= item ? '💾 Update Item' : '➕ Create Item' %>
        </button>
        <a href="/items" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
</main>

<%- include('../partials/footer') %>